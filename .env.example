# ===== Bio Star Monde Eden : variables d'environnement =====
# Copiez ce fichier en .env pour le développement local, ou saisissez ces variables
# dans le tableau de bord de votre hébergeur (Vercel : Settings > Environment Variables).

# Clé serveur de l'application, fournie par le Pi Developer Portal (onglet « API Key »).
# Ne la publiez jamais dans le code ni sur GitHub.
PI_API_KEY=

# Clé de validation du domaine, fournie par le Pi Developer Portal (étape « Verify Domain »).
# Elle est servie automatiquement à l'adresse https://votre-domaine/validation-key.txt
VALIDATION_KEY=

# true uniquement pour tester dans le bac à sable Pi (sandbox.minepi.com) depuis un ordinateur.
# false dans Pi Browser (Testnet comme Mainnet).
PI_SANDBOX=false

# Facultatif : refuse les paiements d'un autre réseau. Valeurs : "Pi Testnet" ou "Pi Network".
PI_NETWORK=Pi Testnet

# Secret de signature des sessions : une longue chaîne aléatoire (au moins 32 caractères).
# Exemple pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Administration : jeton d'accès à /admin.html, et/ou noms d'utilisateur Pi administrateurs (séparés par des virgules).
ADMIN_TOKEN=
ADMIN_USERNAMES=

# Base de données Supabase (Project Settings > API). La clé service_role reste côté serveur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique de l'application, utilisée dans les QR codes des certificats.
APP_URL=https://bio-star-monde.vercel.app

# Facultatif : origines autorisées si l'interface est hébergée sur un autre domaine que l'API.
ALLOWED_ORIGINS=

NODE_ENV=production
