# Bio Star Monde Éden — configuration locale/Testnet
# Promoteur : M. ZOUGBA NATHANAËL — développement et maintenance : Hilaila
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY=false

# Pi Developer Portal (compte de M. ZOUGBA NATHANAËL).
# Clé API serveur : transmise par canal sécurisé, gardée exclusivement côté serveur.
# Utilisez la clé de l'application Testnet, puis une nouvelle clé pour l'application Mainnet.
PI_API_KEY=
# true uniquement pour tester dans le Sandbox sur ordinateur ; false dans le Pi Browser.
PI_SANDBOX=true
# testnet ou mainnet
PI_NETWORK=testnet
# Clé de vérification du domaine, servie sur /validation-key.txt
PI_VALIDATION_KEY=
# Origines autorisées à afficher l'application dans un cadre (Sandbox, Pi Browser)
FRAME_ANCESTORS='self' https://*.minepi.com https://*.pinet.com

SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES
DATABASE_PATH=./data/biostar.db
CONTACT_EMAIL=zoubgaefils@gmail.com
